        <mxCell id="MAwl2OnnpyVytO2v4TgS-188" edge="1" parent="MAwl2OnnpyVytO2v4TgS-199" source="MAwl2OnnpyVytO2v4TgS-106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;startSize=8;endSize=8;endArrow=none;endFill=0;" target="MAwl2OnnpyVytO2v4TgS-173">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-189" parent="MAwl2OnnpyVytO2v4TgS-199" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;rotation=-90;" value="1 : 0..1" vertex="1">
          <mxGeometry height="30" width="33.79157427937916" x="453.37028824833703" y="225" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-190" parent="MAwl2OnnpyVytO2v4TgS-199" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;rotation=90;" value="1 : 1" vertex="1">
          <mxGeometry height="30" width="33.79157427937916" x="430.8425720620843" y="325" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-191" parent="MAwl2OnnpyVytO2v4TgS-199" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="1 : M" vertex="1">
          <mxGeometry height="30" width="33.79157427937916" x="605.4323725055433" y="425" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-193" parent="MAwl2OnnpyVytO2v4TgS-199" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;h3&gt;⚠️ A. &lt;code&gt;MedicalRecord&lt;/code&gt;&lt;/h3&gt;&lt;p&gt;Our assumption:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Patient 1:1 MedicalRecord&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;But a patient may accumulate &lt;strong&gt;multiple diagnoses, treatments and prescriptions over time&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;That could make the current &lt;code&gt;MedicalRecord&lt;/code&gt; structure problematic.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="214.2216851441242" x="90.1108647450111" y="80" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-162" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 100px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Logical Model V2.0&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 100px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Dependency Analysis&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="275" width="2160" x="2695" y="200" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-198" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Functional dependency:&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); font-weight: 400; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;p&gt;Therefore:&lt;/p&gt;&lt;p&gt;&lt;code&gt;BillingID → AppointmentID → PatientID&lt;/code&gt;&lt;/p&gt;&lt;p&gt;That means &lt;code&gt;PatientID&lt;/code&gt; can be determined &lt;strong&gt;indirectly&lt;/strong&gt; from &lt;code&gt;BillingID&lt;/code&gt; through &lt;code&gt;AppointmentID&lt;/code&gt;.&lt;/p&gt;&lt;/div&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="230" width="300" x="4505" y="1002.5" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-195" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div style=&quot;&quot;&gt;⚠️ C. Billing&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;We intentionally avoided:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Billing.PatientID&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;because the relationship is already obtainable:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Billing → Appointment → Patient&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;That decision should be validated under dependency analysis.&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="415" x="4115" y="1002.5" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-196" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;&lt;p&gt;And Billing:&amp;nbsp;&lt;/p&gt;&lt;div class=&quot;___5wvz9a0 ftgm304 f1oy3dpc fm6nont f48hbct&quot; role=&quot;group&quot; aria-label=&quot;Table&quot; tabindex=&quot;0&quot; aria-expanded=&quot;false&quot;&gt;&lt;div class=&quot;___1dmoc29 f10pi13n ftgm304 f1enuhaj fdclmfp f1nbblvp fat0sn4 f1ov4xf1 fekwl8i f1lmfglv f1oz7aqm f1abmfm4 f1w619qj f16h0jq8&quot; role=&quot;group&quot; aria-label=&quot;Table content&quot;&gt;&lt;table class=&quot;___nvz3nv0 f1ddd56o f16vktn6 f1ahpp82 f11qra4b f1uinfot fibjyge fvueend f9yszdx f1fu4s3n f3l3pb3 f10ghnd0 f8fmt76 fjvbh62 f1qrqxae f1vw5qpk fc02sbz fxawf59 fymf513 f1aoyrul f1el8yx3 f1pymoxg f1ofu761 f1y24664 f7coize f1794535 f1o0pw0q fbjjl9v fk1v6el f16pyhcb f1ixlhx9 f12zef0i flu5r5u f19haqzy f1owmcxx f1oddm8q f1004tna fcoaxci fh0ee9u f15v23i2 f1dmj53 f1r1gcv9 f14z1veh ffufd3x f1ypplot f1660cg&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;BillingID&lt;/th&gt;&lt;th&gt;AppointmentID&lt;/th&gt;&lt;th&gt;PatientID&lt;/th&gt;&lt;th&gt;Amount&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B501&lt;/td&gt;&lt;td&gt;A101&lt;/td&gt;&lt;td&gt;P001&lt;/td&gt;&lt;td&gt;1200&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B502&lt;/td&gt;&lt;td&gt;A102&lt;/td&gt;&lt;td&gt;P002&lt;/td&gt;&lt;td&gt;850&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="310" x="4115" y="1232.5" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-197" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;p&gt;But look carefully at &lt;code&gt;B501&lt;/code&gt;.&lt;/p&gt;&lt;p&gt;We know:&amp;nbsp;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;B501 → A101&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;and Appointment &lt;code&gt;A101&lt;/code&gt; already tells us:&amp;nbsp;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;A101 → P001&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Therefore:&amp;nbsp;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;B501 → A101 → P001&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;We don&#39;t actually need &lt;code&gt;P001&lt;/code&gt; repeated inside Billing.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="350" x="4105" y="1382.5" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-194" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;h3&gt;⚠️ B. &lt;code&gt;Doctor.Specialization&lt;/code&gt;&lt;/h3&gt;&lt;p&gt;A doctor might potentially have one or multiple specializations. The project material also refers to specialization within the broader healthcare model. &lt;a href=&quot;https://ibm-my.sharepoint.com/personal/romeo_ndlovu_ibm_com/Documents/Microsoft%20Copilot%20Chat%20Files/Enterprise%20Data%20Architecture%20and%20DataOps.pdf&quot; style=&quot;text-decoration: none; color: rgb(70, 79, 235);&quot;&gt;[Enterprise...ataOps.pdf | PDF]&lt;/a&gt;&lt;/p&gt;&lt;p&gt;We need to determine whether this is just a Doctor attribute or deserves its own entity.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="300" x="4580" y="1367.5" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-203" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;h3&gt;⚠️ D. Appointment ↔ Doctor&lt;/h3&gt;&lt;p&gt;Our &lt;code&gt;AppointmentDoctor&lt;/code&gt; entity has a &lt;strong&gt;composite primary key&lt;/strong&gt;:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;(AppointmentID, DoctorID)&lt;/code&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;That means when we reach &lt;strong&gt;2NF&lt;/strong&gt;, this is the table where we need to be particularly careful about &lt;strong&gt;partial dependencies&lt;/strong&gt; if we add attributes such as &lt;code&gt;DoctorName&lt;/code&gt; or &lt;code&gt;AppointmentDate&lt;/code&gt;.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="400" x="4730" y="1602.5" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-192" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;li&gt;Define attributes&lt;/li&gt;&lt;li&gt;Define PKs and FKs&lt;/li&gt;&lt;li&gt;Establish relationships/cardinality&lt;/li&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="200" x="4730" y="370" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-204" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;fontStyle=4;labelBorderColor=default;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 100px;&quot;&gt;Entity Models &amp;amp; Conceptual Models&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="275" width="2550" x="50" y="225" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-1" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=200;fontFamily=Times New Roman;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="DigiHealth Project" vertex="1">
          <mxGeometry height="310" width="5430" x="85" y="-110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
