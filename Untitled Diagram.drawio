        <mxCell id="MAwl2OnnpyVytO2v4TgS-188" edge="1" parent="MAwl2OnnpyVytO2v4TgS-202" source="MAwl2OnnpyVytO2v4TgS-106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;startSize=8;endSize=8;endArrow=none;endFill=0;" target="MAwl2OnnpyVytO2v4TgS-173">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-189" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;rotation=-90;" value="1 : 0..1" vertex="1">
          <mxGeometry height="30" width="90.60402684563758" x="3446.8514765100667" y="1086.9" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-190" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;rotation=90;" value="1 : 1" vertex="1">
          <mxGeometry height="30" width="50.335570469798654" x="3402.767583892617" y="1156.9" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-191" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="1 : M" vertex="1">
          <mxGeometry height="30" width="65.00335570469798" x="3641.996174496644" y="1241.9" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-193" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 11px; line-height: 20px;&quot;&gt;&lt;h3&gt;⚠️ A. &lt;code&gt;MedicalRecord&lt;/code&gt;&lt;/h3&gt;&lt;p&gt;Our assumption:&amp;nbsp;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;Patient 1:1 Medical_Record&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;But a patient may accumulate &lt;strong&gt;multiple diagnoses, treatments and prescriptions over time&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;That could make the current &lt;code&gt;MedicalRecord&lt;/code&gt; structure problematic.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="296.19463087248323" x="2719.9957718120804" y="870.0000000000001" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-203" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=10;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 12px; line-height: 20px;&quot;&gt;&lt;h3&gt;⚠️ D. Appointment ↔ Doctor&lt;/h3&gt;&lt;p&gt;Our &lt;code&gt;AppointmentDoctor&lt;/code&gt; entity has a &lt;strong&gt;composite primary key&lt;/strong&gt;:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;(AppointmentID, DoctorID)&lt;/code&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;That means when we reach &lt;strong&gt;2NF&lt;/strong&gt;, this is the table where we need to be particularly careful about &lt;strong&gt;partial dependencies&lt;/strong&gt; if we add attributes such as &lt;code&gt;DoctorName&lt;/code&gt; or &lt;code&gt;AppointmentDate&lt;/code&gt;.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="342.28187919463085" x="3900.002281879194" y="1249.95" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-194" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 12px; line-height: 20px;&quot;&gt;&lt;h3&gt;&lt;u&gt;⚠️ B. &lt;code&gt;Doctor.Specialization&lt;/code&gt;&lt;/u&gt;&lt;/h3&gt;&lt;p&gt;A doctor might potentially have one or multiple specializations. The project material also refers to specialization within the broader healthcare model. &lt;a href=&quot;https://ibm-my.sharepoint.com/personal/romeo_ndlovu_ibm_com/Documents/Microsoft%20Copilot%20Chat%20Files/Enterprise%20Data%20Architecture%20and%20DataOps.pdf&quot; style=&quot;text-decoration: none; color: rgb(70, 79, 235);&quot;&gt;[Enterprise...ataOps.pdf | PDF]&lt;/a&gt;&lt;/p&gt;&lt;p&gt;We need to determine whether this is just a Doctor attribute or deserves its own entity.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="370" x="3918.75" y="820" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-209" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;" value="&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;u&gt;&lt;font style=&quot;font-size: 18px;&quot; face=&quot;Garamond&quot;&gt; Example query&lt;/font&gt;&lt;/u&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;Later, if DigiHealth asks: &lt;/span&gt;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Show me every bill belonging to Patient P001.&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;We don&#39;t need &lt;/span&gt;&lt;code spellcheck=&quot;false&quot; style=&quot;white-space: pre-wrap;&quot;&gt;PatientID&lt;/code&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt; inside Billing.&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;We can join the tables:&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;font face=&quot;Garamond&quot;&gt;SQL&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;SELECT b.* &lt;/span&gt;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;FROM Billing b&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;JOIN Appointment a &lt;/span&gt;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ON b.AppointmentID = a.AppointmentID&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;WHERE a.PatientID = &#39;P001&#39;;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;The database follows:&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;b&gt;&lt;strong class=&quot;___1qwroh2 fl43uef f19n0e5&quot; style=&quot;white-space: pre-wrap;&quot;&gt;Billing → Appointment → Patient&lt;/strong&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;So no business capability is lost by removing &lt;/span&gt;&lt;code spellcheck=&quot;false&quot; style=&quot;white-space: pre-wrap;&quot;&gt;PatientID&lt;/code&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt; from Billing.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="400" x="3910" y="630" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-206" edge="1" parent="MAwl2OnnpyVytO2v4TgS-202" source="MAwl2OnnpyVytO2v4TgS-102" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;startSize=8;endSize=8;endArrow=none;endFill=0;" target="MAwl2OnnpyVytO2v4TgS-144">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-210" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;Appointment created → Scheduled → Completed → Bill generated&amp;nbsp; (1 : 0..1)&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="415" x="3467.15" y="830" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-211" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 130%;&quot;&gt;&lt;p&gt;If we say:&amp;nbsp;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;Patient &lt;code&gt;1:1&lt;/code&gt; MedicalRecord&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;we&#39;re saying every Patient &lt;strong&gt;must have exactly one&lt;/strong&gt; MedicalRecord.&lt;/p&gt;&lt;p&gt;But consider a patient who has just registered and hasn&#39;t yet received medical care.&lt;/p&gt;&lt;p&gt;If DigiHealth allows that situation, a more accurate business rule may actually be:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Patient &lt;code&gt;1 ───── 0..1&lt;/code&gt; MedicalRecord&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="270.83" x="2720" y="1087.0700000000002" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-212" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;" value="&lt;div&gt;&lt;span&gt;MedicalRecordID: MR001&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;Diagnosis: Hypertension, Influenza&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;Treatment: Medication A, Medication B&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;Prescription: Drug A, Drug B, Drug C&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;That is exactly where &lt;strong&gt;1NF&lt;/strong&gt; starts becoming relevant....&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;We need to isolate prescription, treatment and diagnosis&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="239.89" x="3000" y="890" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-359" edge="1" parent="MAwl2OnnpyVytO2v4TgS-202" source="MAwl2OnnpyVytO2v4TgS-222" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;fontSize=12;startSize=8;endSize=8;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="MAwl2OnnpyVytO2v4TgS-360">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3160" y="1271.25" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-222" parent="MAwl2OnnpyVytO2v4TgS-202" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;p&gt;The central rule of &lt;strong&gt;First Normal Form&lt;/strong&gt; is:&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;Each attribute should contain a single, atomic value. We should not store repeating groups or lists of values in one column.&lt;/p&gt;&lt;/blockquote&gt;&lt;/div&gt;" vertex="1">
